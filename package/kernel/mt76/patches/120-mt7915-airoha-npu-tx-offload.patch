From: WorkBuddy <noreply@localhost>
Subject: [PATCH] wifi: mt76: mt7915: report DEV_PATH_MTK_WDMA for Airoha NPU

mt7915_net_fill_forward_path() was compiled only under
CONFIG_NET_MEDIATEK_SOC_WED and returned -ENODEV unless the mediatek WED was
active.  On an Airoha AN7581 the NPU takes the wired -> wireless direction
over instead, so the function is now compiled unconditionally and also
accepts a device whose Airoha NPU is present.

The value handed back matters: airoha_ppe_get_wdma_info() copies wdma_idx
into AIROHA_FOE_MAC_WDMA_BAND, so the Airoha side needs the band index the
PPE programs into the FE_PSE_PORT_CDM4 queue, not a WED ring id.

mt7915 does not call mt76_npu_init(): that moves the DMA master to the NPU,
enables HW-RRO and claims the NPU wlan packet buffers, none of which applies
to a kite chip.  mt76_npu_attach() only records the NPU so the forward path
has something to test, and leaves dev->dma_dev, hwrro_mode and rx_token_size
alone.

The wireless -> wired direction is deliberately not covered: mt76_npu_init()
requires HW-RRO for RX reordering and MT7916 publishes no RRO ring.

Signed-off-by: WorkBuddy <noreply@localhost>

--- a/mt76.h
+++ b/mt76.h
@@ -1682,6 +1682,8 @@ void mt76_npu_queue_cleanup(struct mt76_dev *dev, struct mt76_queue *q);
 void mt76_npu_disable_irqs(struct mt76_dev *dev);
 int mt76_npu_init(struct mt76_dev *dev, phys_addr_t phy_addr, int type);
 void mt76_npu_deinit(struct mt76_dev *dev);
+int mt76_npu_attach(struct mt76_dev *dev);
+void mt76_npu_detach(struct mt76_dev *dev);
 void mt76_npu_queue_setup(struct mt76_dev *dev, struct mt76_queue *q);
 void mt76_npu_txdesc_cleanup(struct mt76_queue *q, int index);
 int mt76_npu_net_setup_tc(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
@@ -1730,6 +1732,15 @@ static inline void mt76_npu_deinit(struct mt76_dev *dev)
 {
 }
 
+static inline int mt76_npu_attach(struct mt76_dev *dev)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline void mt76_npu_detach(struct mt76_dev *dev)
+{
+}
+
 static inline void mt76_npu_queue_setup(struct mt76_dev *dev,
 					struct mt76_queue *q)
 {
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -1804,7 +1804,11 @@ out:
 	return ret;
 }
 
-#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+/*
+ * Reports DEV_PATH_MTK_WDMA, which is what both the mediatek WED and the
+ * Airoha PPE consume. It is compiled unconditionally: on an Airoha SoC the
+ * NPU replaces the WED, and mtk_wed_device_active() is false there.
+ */
 static int
 mt7915_net_fill_forward_path(struct ieee80211_hw *hw,
 			     struct ieee80211_vif *vif,
@@ -1818,7 +1822,8 @@ mt7915_net_fill_forward_path(struct ieee80211_hw *hw,
 	struct mt7915_phy *phy = mt7915_hw_phy(hw);
 	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
 
-	if (!mtk_wed_device_active(wed))
+	if (!mtk_wed_device_active(wed) &&
+	    !mt76_npu_device_active(&dev->mt76))
 		return -ENODEV;
 
 	if (msta->wcid.idx > MT7915_WTBL_STA)
@@ -1826,7 +1831,17 @@ mt7915_net_fill_forward_path(struct ieee80211_hw *hw,
 
 	path->type = DEV_PATH_MTK_WDMA;
 	path->dev = ctx->dev;
-	path->mtk_wdma.wdma_idx = wed->wdma_idx;
+	/*
+	 * airoha_ppe_get_wdma_info() copies wdma_idx into the
+	 * AIROHA_FOE_MAC_WDMA_BAND field of the FOE entry, so on the Airoha
+	 * side the value the PPE has to be given is the band, not a WED ring.
+	 */
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+	if (mtk_wed_device_active(wed))
+		path->mtk_wdma.wdma_idx = wed->wdma_idx;
+	else
+#endif
+		path->mtk_wdma.wdma_idx = phy->mt76->band_idx;
 	path->mtk_wdma.bss = mvif->mt76.idx;
 	path->mtk_wdma.queue = phy->mt76->band_idx;
 	if (test_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags) ||
@@ -1839,7 +1854,6 @@ mt7915_net_fill_forward_path(struct ieee80211_hw *hw,
 
 	return 0;
 }
-#endif
 
 static void
 mt7915_reconfig_complete(struct ieee80211_hw *hw,
@@ -1907,8 +1921,8 @@ const struct ieee80211_ops mt7915_ops = {
 	.sta_add_debugfs = mt7915_sta_add_debugfs,
 #endif
 	.set_radar_background = mt7915_set_radar_background,
-#ifdef CONFIG_NET_MEDIATEK_SOC_WED
 	.net_fill_forward_path = mt7915_net_fill_forward_path,
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
 	.net_setup_tc = mt76_wed_net_setup_tc,
 #endif
 	.reconfig_complete = mt7915_reconfig_complete,
--- a/mt7915/pci.c
+++ b/mt7915/pci.c
@@ -136,6 +136,19 @@ static int mt7915_pci_probe(struct pci_dev *pdev,
 	mdev = &dev->mt76;
 	mt7915_wfsys_reset(dev);
 
+	/*
+	 * Record the Airoha NPU so the wired side can learn the wireless
+	 * queue for a station through the netdev forward path. This is not
+	 * mt76_npu_init(): the kite chips keep the Wi-Fi data path, so the
+	 * DMA master and HW-RRO setup stay with the PCIe driver.
+	 */
+#ifdef CONFIG_MT76_NPU
+	if (mt76_npu_attach(mdev))
+		dev_info(mdev->dev, "airoha NPU offload unavailable\n");
+	else
+		dev_info(mdev->dev, "airoha NPU offload enabled\n");
+#endif
+
 	ret = mt7915_mmio_wed_init(dev, pdev, true, &irq);
 	if (ret < 0)
 		goto free_wed_or_irq_vector;
@@ -217,6 +230,9 @@ static void mt7915_pci_remove(struct pci_dev *pdev)
 
 	mdev = pci_get_drvdata(pdev);
 	dev = container_of(mdev, struct mt7915_dev, mt76);
+#ifdef CONFIG_MT76_NPU
+	mt76_npu_detach(mdev);
+#endif
 	mt7915_put_hif2(dev->hif2);
 	mt7915_unregister_device(dev);
 }
--- a/npu.c
+++ b/npu.c
@@ -497,6 +497,72 @@ error_unlock:
 }
 EXPORT_SYMBOL_GPL(mt76_npu_init);
 
+/*
+ * Attach to the NPU without handing the Wi-Fi data path over to it.
+ *
+ * mt76_npu_init() above is for the eagle chips: it moves the DMA master to
+ * the NPU, turns on HW-RRO and takes over the NPU wlan packet buffers.
+ * Kite chips (MT7915/MT7916) republish no RRO ring, so none of that applies.
+ *
+ * The wired side still needs to know where to push frames destined to a
+ * station: airoha_ppe_foe_entry_prepare() calls dev_fill_forward_path() and
+ * programs FE_PSE_PORT_CDM4 with the queue band and wcid it gets back. That
+ * only requires the *presence* of the NPU to be recorded, which is what this
+ * does. dev->dma_dev, hwrro_mode and rx_token_size are left untouched.
+ *
+ * The presence test is the "airoha,npu" phandle of the caller's DT node, so
+ * a board that does not wire the NPU up simply fails here and keeps its
+ * forward path disabled.
+ */
+int mt76_npu_attach(struct mt76_dev *dev)
+{
+	struct airoha_npu *npu;
+	int err = 0;
+
+	mutex_lock(&dev->mutex);
+
+	npu = airoha_npu_get(dev->dev);
+	if (IS_ERR(npu)) {
+		request_module("airoha-npu");
+		npu = airoha_npu_get(dev->dev);
+	}
+
+	if (IS_ERR(npu)) {
+		err = PTR_ERR(npu);
+		goto unlock;
+	}
+
+	/* CONFIG_NET_AIROHA_NPU=n stubs out airoha_npu_get() to NULL */
+	if (!npu) {
+		err = -ENODEV;
+		goto unlock;
+	}
+
+	rcu_assign_pointer(dev->mmio.npu, npu);
+	synchronize_rcu();
+
+unlock:
+	mutex_unlock(&dev->mutex);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(mt76_npu_attach);
+
+void mt76_npu_detach(struct mt76_dev *dev)
+{
+	struct airoha_npu *npu;
+
+	mutex_lock(&dev->mutex);
+
+	npu = rcu_replace_pointer(dev->mmio.npu, NULL,
+				  lockdep_is_held(&dev->mutex));
+	if (npu)
+		airoha_npu_put(npu);
+
+	mutex_unlock(&dev->mutex);
+}
+EXPORT_SYMBOL_GPL(mt76_npu_detach);
+
 void mt76_npu_deinit(struct mt76_dev *dev)
 {
 	struct airoha_ppe_dev *ppe_dev;
