+/* Map a line mode onto the PCS profile that carries its line rate. */
+enum airoha_pcs_pon_mode
+airoha_xpon_mode_to_pcs_profile(enum airoha_xpon_mode mode)
+{
+	switch (mode) {
+	case AIROHA_XPON_MODE_GPON:
+		return AIROHA_PCS_PON_MODE_GPON;
+	case AIROHA_XPON_MODE_XGPON:
+		return AIROHA_PCS_PON_MODE_XGPON;
+	case AIROHA_XPON_MODE_XGSPON:
+		return AIROHA_PCS_PON_MODE_XGSPON;
+	case AIROHA_XPON_MODE_EPON_1G:
+		return AIROHA_PCS_PON_MODE_EPON_1G;
+	case AIROHA_XPON_MODE_EPON_10G_1G:
+		return AIROHA_PCS_PON_MODE_EPON_10G_1G;
+	case AIROHA_XPON_MODE_EPON_10G_10G:
+		return AIROHA_PCS_PON_MODE_EPON_10G_10G;
+	default:
+		return AIROHA_PCS_PON_MODE_XGPON;
+	}
+}
